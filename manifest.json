{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "mituan",
  "version": "0.4.0",
  "homepage_url": "https://tracker.eonmaze.com/",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "cookies",
    "scripting",
    "activeTab",
    "background"
  ],
  "host_permissions": [
    "https://mc.manuscriptcentral.com/*",
    "https://ieee.submission.researchexchange.com/*",
    "https://ieee-rex.scienceconnect.io/*",
    "https://www.ieee.org/*",
    "https://services10.ieee.org/*",
    "https://ifac-sms.org/*",
    "https://ifac.papercept.net/*",
    "https://cms.amss.ac.cn/*",
    "https://tnlkuelk67.execute-api.us-east-1.amazonaws.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mc.manuscriptcentral.com/*",
        "https://ieee.submission.researchexchange.com/*",
        "https://www.ieee.org/profile/*",
        "https://services10.ieee.org/*",
        "https://ifac-sms.org/*",
        "https://cms.amss.ac.cn/*"
      ],
      "js": [
        "content/login.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
